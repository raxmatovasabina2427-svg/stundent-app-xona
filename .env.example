NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Render: ilova ichida Internal Database URL (DB_SSL=false), lokaldan External URL (DB_SSL=true)
DATABASE_URL=postgres://user:password@host:5432/dekanat_v2
DB_SSL=true

# Kamida 16 belgi; prod uchun 64 ta tasodifiy belgi
SESSION_SECRET=bu-yerga-uzun-tasodifiy-satr-yozing

# /internal/cron/* uchun maxfiy kalit
CRON_SECRET=bu-yerga-boshqa-tasodifiy-satr

# Faqat faol admin bo'lmasa ishlatiladi. Birinchi kirishdan keyin o'chirib qo'ying.
ADMIN_LOGIN=admin
ADMIN_PAROL=kamida8belgi

# Testlar uchun ALOHIDA baza (testlar uni tozalaydi!)
# TEST_DATABASE_URL=postgres://user:password@localhost:5432/dekanat_test
