<link rel="stylesheet" href="/p/xona_bron/app.css">
<script src="/p/xona_bron/app.js" defer></script>
<div class="head spread"><div><h1>Xonalarni boshqarish</h1><p class="muted">Kompyuter, laboratoriya va ma’ruza xonalari.</p></div><a class="btn btn-primary" href="/admin/xona_bron/resurslar/yangi">+ Xona qo‘shish</a></div>
{{#if resources.length}}<div class="table-wrap"><table class="table stack"><thead><tr><th>Nomi</th><th>Turi</th><th>Bino/xona</th><th>Sig‘im</th><th>Holat</th><th>Amallar</th></tr></thead><tbody>{{#each resources}}<tr><td data-l="Nomi">{{nomi}}</td><td data-l="Turi">{{this.turi}}</td><td data-l="Joylashuv">{{bino}} / {{xona_raqami}}</td><td data-l="Sig‘im">{{this.sigim}}</td><td data-l="Holat"><span class="badge">{{status}}</span></td><td class="actions" data-l="Amallar"><a class="btn btn-sm" href="/admin/xona_bron/resurslar/{{id}}/tahrir">Tahrirlash</a><form method="post" action="/admin/xona_bron/resurslar/{{id}}/status">{{> csrf}}<input type="hidden" name="status" value="{{#if (eq status 'faol')}}faol_emas{{else}}faol{{/if}}"><button class="btn btn-sm" type="submit">{{#if (eq status 'faol')}}Faolsizlantirish{{else}}Faollashtirish{{/if}}</button></form></td></tr>{{/each}}</tbody></table></div>{{else}}<div class="card empty">Hozircha xona qo‘shilmagan.</div>{{/if}}
