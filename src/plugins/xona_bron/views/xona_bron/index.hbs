<link rel="stylesheet" href="/p/xona_bron/app.css">
<script src="/p/xona_bron/app.js" defer></script>
<div class="head spread"><div><h1>Xonalarni bron qilish</h1><p class="muted">Universitet xonalarini tanlang va bo‘sh vaqtni band qiling.</p></div><a class="btn btn-primary" href="/xona_bron/mening">Mening bronlarim</a></div>
<form class="filters card" method="get" action="/xona_bron"><div class="field"><label for="turi">Xona turi</label><select id="turi" name="turi"><option value="">Barchasi</option><option value="kompyuter" {{sel filters.turi 'kompyuter'}}>Kompyuter xonasi</option><option value="laboratoriya" {{sel filters.turi 'laboratoriya'}}>Laboratoriya</option><option value="maruza" {{sel filters.turi 'maruza'}}>Ma’ruza xonasi</option></select></div><button class="btn btn-primary" type="submit">Filterlash</button></form>
{{#if resources.length}}<div class="grid two">{{#each resources}}<article class="card"><div class="spread"><span class="badge">{{#if (eq turi 'kompyuter')}}Kompyuter{{else if (eq turi 'laboratoriya')}}Laboratoriya{{else}}Ma’ruza{{/if}}</span><span class="badge b-on">Faol</span></div><h2>{{nomi}}</h2><p class="muted">{{bino}} · {{#if xona_raqami}}{{xona_raqami}}-xona{{else}}Xona raqami ko‘rsatilmagan{{/if}}</p><div class="row"><span>Sig‘imi: <b>{{this.sigim}} kishi</b></span><span>Ish vaqti: <b>{{ish_boshlanish}}–{{ish_tugash}}</b></span></div><p class="muted">{{jihozlar}}</p><div class="row"><a class="btn" href="/xona_bron/{{id}}">Batafsil</a><a class="btn btn-primary" href="/xona_bron/yangi?resurs_id={{id}}">Bron qilish</a></div></article>{{/each}}</div>{{else}}<div class="card empty">Hozircha faol xonalar mavjud emas.</div>{{/if}}
