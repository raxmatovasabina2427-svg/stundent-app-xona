<link rel="stylesheet" href="/p/xona_bron/app.css">
<script src="/p/xona_bron/app.js" defer></script>
<div class="head"><h1>Yopiq vaqtlarni boshqarish</h1><p class="muted">Ta’mirlash yoki boshqa sabab bilan xona foydalanilmaydigan vaqtlar.</p></div>
<form class="card" method="post" action="/admin/xona_bron/yopiq-vaqtlar">{{> csrf}}<h2>Yopiq vaqt qo‘shish</h2><div class="grid two"><div class="field"><label for="resurs_id">Xona</label><select id="resurs_id" name="resurs_id" required><option value="">Tanlang</option>{{#each resources}}<option value="{{id}}">{{nomi}}</option>{{/each}}</select></div><div class="field"><label for="sana">Sana</label><input id="sana" type="date" name="sana" min="{{today}}" required></div><div class="field"><label for="boshlanish">Boshlanish</label><input id="boshlanish" type="time" name="boshlanish" required></div><div class="field"><label for="tugash">Tugash</label><input id="tugash" type="time" name="tugash" required></div></div><div class="field"><label for="sabab">Sabab</label><input id="sabab" name="sabab" maxlength="300" required></div><button class="btn btn-primary">Saqlash</button></form>
<div class="card"><h2>Mavjud yopiq vaqtlar</h2>{{#if closed.length}}<div class="table-wrap"><table class="table stack"><thead><tr><th>Xona</th><th>Sana</th><th>Vaqt</th><th>Sabab</th><th>Amal</th></tr></thead><tbody>{{#each closed}}<tr><td data-l="Xona">{{resurs_nomi}}</td><td data-l="Sana">{{sana sana}}</td><td data-l="Vaqt">{{boshlanish}}–{{tugash}}</td><td data-l="Sabab">{{sabab}}</td><td data-l="Amal"><form method="post" action="/admin/xona_bron/yopiq-vaqtlar/{{id}}/och">{{> csrf}}<button class="btn btn-sm" type="submit">Olib tashlash</button></form></td></tr>{{/each}}</tbody></table></div>{{else}}<p class="empty">Yopiq vaqtlar belgilanmagan.</p>{{/if}}</div>
