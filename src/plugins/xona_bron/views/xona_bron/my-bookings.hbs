<link rel="stylesheet" href="/p/xona_bron/app.css">
<script src="/p/xona_bron/app.js" defer></script>
<div class="head spread"><div><h1>Mening bronlarim</h1><p class="muted">Yuborgan bron so‘rovlaringiz va ularning holati.</p></div><a class="btn btn-primary" href="/xona_bron">Yangi bron</a></div>
{{#if bookings.length}}<div class="table-wrap"><table class="table stack"><thead><tr><th>Xona</th><th>Sana</th><th>Vaqt</th><th>Odam</th><th>Holat</th><th>Amal</th></tr></thead><tbody>{{#each bookings}}<tr><td data-l="Xona">{{resurs_nomi}} <span class="muted">({{this.turi}})</span></td><td data-l="Sana">{{sana sana}}</td><td data-l="Vaqt">{{boshlanish}}–{{tugash}}</td><td data-l="Odam">{{odam_soni}}</td><td data-l="Holat"><span class="badge">{{holat status}}</span></td><td class="actions" data-l="Amal"><a class="btn btn-sm" href="/xona_bron/bron/{{id}}">Ko‘rish</a>{{#if (or (eq status 'kutilmoqda') (eq status 'tasdiqlandi'))}}<form method="post" action="/xona_bron/bron/{{id}}/bekor" data-confirm="Bronni bekor qilasizmi?">{{> csrf}}<button class="btn btn-red btn-sm" type="submit">Bekor qilish</button></form>{{/if}}</td></tr>{{/each}}</tbody></table></div>{{else}}<div class="card empty">Sizda hozircha bronlar mavjud emas.</div>{{/if}}
