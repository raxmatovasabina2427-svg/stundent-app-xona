<link rel="stylesheet" href="/p/xona_bron/app.css">
<script src="/p/xona_bron/app.js" defer></script>
<div class="head"><h1>Bronlarni boshqarish</h1><p class="muted">Kutilayotgan so‘rovlarni ko‘rib chiqing.</p></div>
{{#if bookings.length}}<div class="table-wrap"><table class="table stack"><thead><tr><th>Foydalanuvchi</th><th>Xona</th><th>Sana/vaqt</th><th>Odam</th><th>Maqsad</th><th>Holat</th><th>Amal</th></tr></thead><tbody>{{#each bookings}}<tr><td data-l="Foydalanuvchi">{{ism}} {{familiya}}</td><td data-l="Xona">{{resurs_nomi}}</td><td data-l="Sana/vaqt">{{sana sana}}<br>{{boshlanish}}–{{tugash}}</td><td data-l="Odam">{{odam_soni}}</td><td data-l="Maqsad">{{sabab}}</td><td data-l="Holat"><span class="badge">{{holat status}}</span></td><td class="actions" data-l="Amal">{{#if (eq status 'kutilmoqda')}}<form method="post" action="/admin/xona_bron/bronlar/{{id}}/tasdiq">{{> csrf}}<button class="btn btn-green btn-sm" type="submit">Tasdiqlash</button></form><form method="post" action="/admin/xona_bron/bronlar/{{id}}/rad">{{> csrf}}<input name="izoh" placeholder="Rad etish sababi" minlength="3" maxlength="500" required><button class="btn btn-red btn-sm" type="submit">Rad etish</button></form>{{else}}—{{/if}}</td></tr>{{/each}}</tbody></table></div>{{else}}<div class="card empty">Bron so‘rovlari mavjud emas.</div>{{/if}}
