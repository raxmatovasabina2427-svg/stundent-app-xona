<link rel="stylesheet" href="/p/xona_bron/app.css">
<script src="/p/xona_bron/app.js" defer></script>
<div class="head spread"><div><a href="/xona_bron" class="muted">← Xonalar</a><h1>{{resource.nomi}}</h1><p class="muted">{{resource.bino}} · {{resource.xona_raqami}}-xona</p></div><a class="btn btn-primary" href="/xona_bron/yangi?resurs_id={{resource.id}}">Bron qilish</a></div>
<div class="card"><div class="grid two"><p><b>Turi:</b> {{resource.turi}}</p><p><b>Sig‘imi:</b> {{resource.sigim}} kishi</p><p><b>Qavat:</b> {{resource.qavat}}</p><p><b>Ish vaqti:</b> {{resource.ish_boshlanish}}–{{resource.ish_tugash}}</p></div><p><b>Jihozlar:</b> {{resource.jihozlar}}</p></div>
<form class="card row" method="get" action="/xona_bron/{{resource.id}}"><div class="field"><label for="sana">Sanani tanlang</label><input id="sana" type="date" name="sana" min="{{today}}" value="{{bron_sana}}"></div><button class="btn" type="submit">Jadvalni ko‘rish</button></form>
<div class="card"><h2>{{sana bron_sana}} kungi band vaqtlar</h2>{{#if bookings.length}}<div class="table-wrap"><table class="table stack"><thead><tr><th>Boshlanish</th><th>Tugash</th><th>Holat</th></tr></thead><tbody>{{#each bookings}}<tr><td data-l="Boshlanish">{{boshlanish}}</td><td data-l="Tugash">{{tugash}}</td><td data-l="Holat"><span class="badge">{{holat status}}</span></td></tr>{{/each}}</tbody></table></div>{{else}}<p class="empty">Bu sanada band vaqtlar yo‘q.</p>{{/if}}</div>
